# cp .env.example .env

# PostgreSQL
POSTGRES_URL=postgres://user:password@localhost:5432/jewelscart

# NextAuth
AUTH_SECRET= # openssl rand -base64 32 to generate random string

# Google OAuth https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma separated developer emails for Google sign-in
DEVELOPER_EMAILS=admin@gmail.com, admin2@gmail.com

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:5697

# Neko Mail (Custom Private Email API)
NEKO_MAIL_URL=
NEKO_MAIL_API_KEY=
NEKO_MAIL_FROM=

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=